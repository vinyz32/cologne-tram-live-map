# Local configuration only. Never commit a real .env file.
#
# The experimental HAFAS adapter intentionally ships without a provider
# access identifier. Supply one only if you are authorized to use it.
COLOGNE_TRAM_HAFAS_AID=

# Optional runtime paths
# COLOGNE_TRAM_ACCESS_LOG=
# COLOGNE_TRAM_SECURITY_TRIP_FILE=

# Optional public-demo safety thresholds (per 60-second window).
# If one is exceeded, the in-process circuit breaker trips and prevents
# further HAFAS requests until the service restarts.
# COLOGNE_TRAM_SECURITY_MAX_REQUESTS=600
# COLOGNE_TRAM_SECURITY_MAX_FORCED_REFRESHES=60
# COLOGNE_TRAM_SECURITY_MAX_SUSPICIOUS_REQUESTS=40
